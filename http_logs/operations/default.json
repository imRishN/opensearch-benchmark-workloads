  "body": {
      "query": {
          "bool": {
              "must": [
                  {
                      "range": {
                          "@timestamp": {
                              "gte": "1998-05-01T00:00:00Z",
                              "lt": "1998-05-02T00:00:00Z"
                          }
                      }
                  },
                  {
                      "match": {
                          "status": "200"
                      }
                  }
              ]
          }
      }
  },
  "detailed-results": true,
  "assertions": [
      {
          "property": "hits",
          "condition": "==",
          "value": 10000
      }
  ]
},
